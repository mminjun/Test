# /etc/systemd/system/memo.service
#
# gunicorn 으로 앱을 실행하는 유닛. root 가 아닌 memoapp 유저로 동작하며 127.0.0.1:8000 에만 바인딩한다.
# 외부 트래픽은 nginx(443) -> 127.0.0.1:8000 으로만 들어온다.

[Unit]
Description=Memo service (gunicorn)
Requires=memo-seed.service
After=network.target memo-seed.service

[Service]
Type=simple
# [방어] root 가 아닌 전용 시스템 계정으로 실행. 앱이 뚫려도 memoapp 권한 이상은 얻지 못함
User=memoapp
Group=memoapp
UMask=0077
WorkingDirectory=/opt/memo
# SECRET_KEY, MEMO_DB_PATH, TRUST_PROXY 만 포함. ADMIN_PASSWORD/FLAG_FILE 은 앱 프로세스 환경에 넣지 않음
EnvironmentFile=/etc/memo/memo.env
ExecStart=/opt/memo/.venv/bin/gunicorn \
    --workers 2 \
    --threads 2 \
    --bind 127.0.0.1:8000 \
    --timeout 30 \
    --graceful-timeout 10 \
    --keep-alive 5 \
    --max-requests 2000 \
    --max-requests-jitter 200 \
    --access-logfile - \
    --error-logfile - \
    app:app
Restart=on-failure
RestartSec=3

# ---- sandbox ----
# [방어] 권한 상승 차단: setuid 바이너리 실행 등으로 권한을 높일 수 없음
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# [방어] 파일시스템을 읽기 전용으로 마운트. DB 디렉터리만 쓰기 가능. 소스(/opt/memo) 변조 불가
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/memo
# [방어] 플래그 파일과 시드용 비밀 파일은 앱 네임스페이스에서 아예 보이지 않게 함 (파일 권한 위에 한 겹 더)
InaccessiblePaths=-/etc/memo/flag -/etc/memo/seed.env
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# [방어] 다른 프로세스 정보(/proc/<pid>) 열람 차단. 다른 프로세스의 environ/cmdline 읽기 불가
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# 문제가 생기면 이 줄만 제거 (일부 C 확장 모듈이 W+X 메모리를 요구할 수 있음)
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete

[Install]
WantedBy=multi-user.target
