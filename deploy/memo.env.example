# /etc/memo/memo.env  (root:root 0600)
# 앱(gunicorn) 프로세스와 시드 유닛이 공통으로 읽는 설정. 비밀값은 SECRET_KEY 하나만 들어간다.
# 예시 파일이므로 실제 값은 setup.sh 가 생성한다. 이 파일을 그대로 쓰지 말 것.

# 세션 서명 키. 반드시 무작위 값 (예: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX

# DB 를 소스 디렉터리 밖(/var/lib/memo)에 둔다
MEMO_DB_PATH=/var/lib/memo/memo.db

# nginx 뒤에서 실행되므로 X-Forwarded-For / X-Forwarded-Proto 신뢰 (rate limit 의 실제 클라이언트 IP 용)
TRUST_PROXY=1

# CSRF 토큰 검사는 항상 켜 둔다. 외부 자동화 도구가 폼 없이 바로 POST 해야 하는 경우에만 아래를 사용
# MEMO_CSRF_EXEMPT=login,register
