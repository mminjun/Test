# /etc/memo/seed.env  (root:root 0600)
# memo-seed.service(root) 만 읽는다. 앱(memoapp) 프로세스 환경에는 들어가지 않는다.

# admin 로그인 비밀번호. 충분히 길고 무작위여야 함 (예: python3 -c "import secrets; print(secrets.token_urlsafe(24))")
# 이 값을 바꾸고 `systemctl restart memo` 하면 admin 비밀번호가 즉시 교체된다.
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# admin 아이디를 바꾸고 싶으면 주석 해제
# ADMIN_USERNAME=admin

# 플래그 파일 경로는 유닛 파일에서 FLAG_FILE=/etc/memo/flag 로 고정되어 있다.
