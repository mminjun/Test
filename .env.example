# .env  (compose.yaml 의 env_file). 실제 파일은 .env 로 복사해 채우고, 절대 커밋하지 않는다 (.gitignore 에 있음)
#   cp .env.example .env && chmod 0600 .env

# 세션 서명 키. 반드시 무작위 (python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX

# admin 비밀번호. 충분히 길고 무작위 (python3 -c "import secrets; print(secrets.token_urlsafe(24))")
# 값을 바꾸고 docker compose up -d --force-recreate 하면 admin 비밀번호가 교체된다
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# 플래그. admin 의 "관리자 전용 메모" 내용이 된다. 소스코드에는 없고 이 파일(서버)에만 존재
ADMIN_MEMO_CONTENT=SBOB{REPLACE_ME}

# DB 는 compose 가 마운트하는 ./data 볼륨 안에 둔다 (컨테이너 재생성 후에도 유지)
MEMO_DB_PATH=/app/data/memo.db

# nginx 뒤에서 실행되므로 X-Forwarded-For 를 신뢰 (로그인 rate limit 의 실제 클라이언트 IP 용)
TRUST_PROXY=1
